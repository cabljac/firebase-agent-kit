    "genkit": "~1.44.0"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@genkit-ai/express": "1.44.0",
    "@genkit-ai/firebase": "1.44.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "genkit": "1.44.0",
    "typescript": "5.9.3"
  }
