{
  "name": "@cabljac/firebase-agent-kit-core",
  "version": "0.0.0",
  "description": "Serve Genkit agents from Firebase Cloud Functions with per-user sessions and turn locking",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cabljac/firebase-agent-kit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "lib/index.js",
