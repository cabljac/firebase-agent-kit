{
  "functions": [
    {
      "kit": "firebase-agent-kit",
      "sourcePackage": { "name": "@cabljac/firebase-agent-kit" },
      "source": "app",
      "runtime": "nodejs22",
      "instances": {
        "support": "config/support",
        "sales": "config/sales",
        "typo": "config/typo",
        "missing": "config/missing",
        "guarded": "config/guarded",
        "loose": "config/loose",
        "skilled": "config/sales",
        "badskill": "config/sales",
        "retried": "config/sales"
      }
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
