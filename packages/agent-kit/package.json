{
  "name": "genkit-agent-kit",
  "version": "0.0.0",
  "description": "Function Kit that serves a Genkit prompt agent per instance, with per-user sessions and turn locking",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/lib.d.ts",
      "default": "./lib/lib.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@genkit-ai/ai": "1.44.0",
    "@genkit-ai/express": "1.44.0",
    "@genkit-ai/firebase": "1.44.0",
    "@genkit-ai/google-genai": "1.44.0",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "genkit": "1.44.0",
    "genkit-agent-functions": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "express": "5.3.0",
    "typescript": "5.9.3"
  }
}
